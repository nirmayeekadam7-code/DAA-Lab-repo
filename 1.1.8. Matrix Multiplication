#include <stdio.h>

int main() {
    int m, n, r, p;
    int A[100][100], B[100][100], C[100][100];

    scanf("%d%d", &m, &n);

    // Read first matrix
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &A[i][j]);
        }
    }

    // Read dimensions of second matrix
    scanf("%d%d", &r, &p);

    // Check compatibility
    if (n != r) {
        printf("Invalid input\n");
        return 0;
    }

    // Read second matrix
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < p; j++) {
            scanf("%d", &B[i][j]);
        }
    }

    // Matrix multiplication
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < p; j++) {
            C[i][j] = 0;

            for (int k = 0; k < n; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    // Print result
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < p; j++) {
            if (j > 0) {
                printf(" ");
            }
            printf("%d", C[i][j]);
        }
        printf(" \n");
    }

    return 0;
}
